datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CASHIER
}

enum MovementType {
  RECEIPT     // Приход товара
  WRITE_OFF   // Списание товара
  TRANSFER    // Перемещение товара
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum OrderStatus {
  COMPLETED
  REFUNDED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(CASHIER)
  pinCode      String?        // 4-6 digit PIN for quick cashier unlock
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens  RefreshToken[]
  shifts         CashShift[]
  orders         Order[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id             String              @id @default(uuid())
  name           String
  sku            String              @unique // Артикул
  barcode        String              @unique // Штрихкод
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costPrice      Float               @default(0) // Цена закупки
  salePrice      Float               @default(0) // Цена продажи
  stockQuantity  Float               @default(0) // Общий остаток
  minStockAlert  Float               @default(5) // Порог предупреждения
  imageUrl       String?             // Фото товара
  unit           String              @default("шт") // Единица измерения
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  stocks         Stock[]
  movementItems  StockMovementItem[]
  orderItems     OrderItem[]

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@map("products")
}

model Warehouse {
  id          String          @id @default(uuid())
  name        String
  address     String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  stocks      Stock[]
  sourceMovements StockMovement[] @relation("SourceWarehouse")
  targetMovements StockMovement[] @relation("TargetWarehouse")

  @@map("warehouses")
}

model Stock {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("stocks")
}

model StockMovement {
  id                String              @id @default(uuid())
  movementNumber    String              @unique // e.g. MOV-20260922-001
  type              MovementType
  sourceWarehouseId String?
  sourceWarehouse   Warehouse?          @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse?          @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  reason            String?             // Причина (поставка, брак, инвентаризация и т.д.)
  notes             String?
  items             StockMovementItem[]
  createdAt         DateTime            @default(now())

  @@map("stock_movements")
}

model StockMovementItem {
  id         String        @id @default(uuid())
  movementId String
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float
  costPrice  Float         @default(0)

  @@map("stock_movement_items")
}

model CashShift {
  id             String      @id @default(uuid())
  shiftNumber    Int         @default(autoincrement())
  cashierId      String
  cashier        User        @relation(fields: [cashierId], references: [id])
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  startingCash   Float       @default(0)
  expectedCash   Float       @default(0)
  actualCash     Float?
  cashDifference Float?
  status         ShiftStatus @default(OPEN)
  notes          String?
  orders         Order[]

  @@map("cash_shifts")
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique // e.g. ORD-10001
  shiftId        String?
  shift          CashShift?    @relation(fields: [shiftId], references: [id])
  cashierId      String
  cashier        User          @relation(fields: [cashierId], references: [id])
  subtotal       Float
  discountAmount Float         @default(0)
  totalAmount    Float
  paymentMethod  PaymentMethod @default(CASH)
  cashReceived   Float?
  changeGiven    Float?
  status         OrderStatus   @default(COMPLETED)
  refundReason   String?
  createdAt      DateTime      @default(now())

  items          OrderItem[]

  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  sku         String
  barcode     String
  quantity    Float
  price       Float    // Цена продажи на момент покупки
  costPrice   Float    @default(0) // Себестоимость для точного расчёта маржи
  total       Float

  @@map("order_items")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. CREATE, UPDATE, DELETE, LOGIN, REFUND, SHIFT_CLOSE
  entity    String   // e.g. Product, Order, User, StockMovement
  entityId  String?
  details   String?  // JSON or text description of changes
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
